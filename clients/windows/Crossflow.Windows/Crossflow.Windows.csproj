<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../design-tokens.json" Link="design-tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../examples/layout-four-screens.json" Link="sample-layout.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../target/release/crossflow_bridge.dll" Link="crossflow_bridge.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../target/release/crossflow_bridge.dll')" />
    <Content Include="../../../target/release/crossflow.exe" Link="crossflow.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../target/release/crossflow.exe')" />
    <Content Include="../../../.tools/pairing-package/crossflow-enroll.exe" Link="crossflow-enroll.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../.tools/pairing-package/crossflow-enroll.exe')" />
    <Content Include="../../../.tools/pairing-package/libc++.dll" Link="libc++.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../.tools/pairing-package/libc++.dll')" />
    <Content Include="../../../.tools/pairing-package/libunwind.dll" Link="libunwind.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../.tools/pairing-package/libunwind.dll')" />
    <Content Include="../../../.tools/pairing-package/libwinpthread-1.dll" Link="libwinpthread-1.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../.tools/pairing-package/libwinpthread-1.dll')" />
  </ItemGroup>
</Project>
